# Copy this file to .env. Never commit real keys.
# Supabase project: Settings > API. Both URL values refer to the SAME project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_URL=https://your-project.supabase.co
# SERVER ONLY: legacy service_role key or the current server secret key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SERVER ONLY: Razorpay dashboard > Account & Settings > API Keys.
# Start with TEST keys. Live keys require merchant activation.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-key-secret
# Set the same random secret in the Razorpay webhook dashboard.
RAZORPAY_WEBHOOK_SECRET=your-long-random-webhook-secret

# SERVER ONLY: Google AI Studio key for Gemini-generated questions/feedback.
# Without it, the existing local practice engine is used.
GEMINI_API_KEY=
# Optional fallback order (at most two models).
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
# Optional. Browser speech features are used when supported if this is omitted.
SPEECHMATICS_API_KEY=

# Public support address displayed on terms/privacy pages. Set before launch.
VITE_SUPPORT_EMAIL=
# Optional local server port. Use HTTPS on your production host.
PORT=3000
